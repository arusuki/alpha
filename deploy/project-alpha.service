[Unit]
Description=project alpha cluster control
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/project-alpha
ExecStart=/opt/project-alpha/bin/project-alpha --control --data-dir /var/lib/project-alpha-control --host 127.0.0.1 --port 8765
# Must match bastion init --service-user; use an existing ordinary service user.
User=project-alpha
UMask=0077
StateDirectory=project-alpha-control
StateDirectoryMode=0700
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
KillMode=control-group
# Bastion account operations use password-authenticated sudo.
NoNewPrivileges=false
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

[Install]
WantedBy=multi-user.target
