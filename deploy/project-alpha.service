[Unit]
Description=project alpha cluster control
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/project-alpha
ExecStart=/opt/project-alpha/bin/project-alpha --control --data-dir /var/lib/project-alpha-control --host 127.0.0.1 --port 8765
DynamicUser=true
UMask=0077
StateDirectory=project-alpha-control
StateDirectoryMode=0700
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
KillMode=control-group
NoNewPrivileges=true
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

[Install]
WantedBy=multi-user.target
