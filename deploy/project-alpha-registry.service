[Unit]
Description=project alpha public registry
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/project-alpha
# Prepare the 0600 entry password file and replace the public hostname.
# The connection token is generated in the data directory and printed on startup.
LoadCredential=reg-pass:/etc/project-alpha/reg-pass
ExecStart=/opt/project-alpha/bin/project-alpha --registry --data-dir /var/lib/project-alpha-registry --host 127.0.0.1 --port 8767 --reg-pass-file %d/reg-pass --allowed-host register.example.com --secure-cookie
DynamicUser=true
UMask=0077
StateDirectory=project-alpha-registry
StateDirectoryMode=0700
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
KillMode=control-group
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
